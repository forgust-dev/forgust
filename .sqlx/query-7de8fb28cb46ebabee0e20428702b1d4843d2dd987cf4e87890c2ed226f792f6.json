  "db_name": "PostgreSQL",
  "query": "SELECT w.id, w.project_id, w.namespace_id, w.url, w.secret_enc, w.events, w.enabled, w.created_at, w.format\n         FROM webhooks w\n         WHERE w.enabled AND $2 = ANY(w.events)\n           AND (w.project_id = $1\n                OR w.namespace_id = ANY((SELECT n.traversal_ids FROM projects p JOIN namespaces n ON n.id = p.namespace_id WHERE p.id = $1)::bigint[]))",
