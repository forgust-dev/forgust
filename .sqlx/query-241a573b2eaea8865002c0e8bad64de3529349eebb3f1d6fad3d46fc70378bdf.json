{
  "db_name": "PostgreSQL",
  "query": "SELECT nullif(p.quota_bytes, 0) AS project_quota, root.id AS \"root_id!\", root.path AS \"root_path!\", root.kind AS \"root_kind!\",\n                  nullif(coalesce(root.quota_bytes, s.namespace_quota_bytes), 0) AS namespace_quota\n             FROM projects p\n             JOIN namespaces n ON n.id = p.namespace_id\n             JOIN namespaces root ON root.id = n.traversal_ids[1]\n            CROSS JOIN instance_settings s\n            WHERE p.id = $1",
