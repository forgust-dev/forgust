{
  "db_name": "PostgreSQL",
  "query": "SELECT l.id, l.project_id, l.path, l.owner_id, u.username AS owner_username, u.name AS owner_name, l.created_at\n           FROM lfs_locks l JOIN users u ON u.id = l.owner_id\n          WHERE l.project_id = $1 AND ($2::text IS NULL OR l.path = $2) AND ($3::bigint IS NULL OR l.id = $3) AND l.id > $4\n          ORDER BY l.id LIMIT $5",
