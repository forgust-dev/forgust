  "db_name": "PostgreSQL",
  "query": "SELECT m.id, m.source_type, m.source_id, m.user_id, u.username, u.name, u.user_type, m.access_level,\n                m.expires_at, m.created_at\n         FROM members m JOIN users u ON u.id = m.user_id\n         WHERE m.source_type = $1 AND m.source_id = $2\n         ORDER BY m.access_level DESC, u.username",
