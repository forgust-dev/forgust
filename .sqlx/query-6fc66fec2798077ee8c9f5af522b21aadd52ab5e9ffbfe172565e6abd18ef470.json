  "db_name": "PostgreSQL",
  "query": "SELECT t.build_id, b.name AS job_name, b.stage, t.total, t.failed, t.errored, t.skipped, t.duration, t.failures, t.cases, t.error\n           FROM ci_build_test_reports t JOIN ci_builds b ON b.id = t.build_id\n          WHERE t.pipeline_id = $1 AND NOT b.retried\n          ORDER BY b.stage_idx, b.name",
