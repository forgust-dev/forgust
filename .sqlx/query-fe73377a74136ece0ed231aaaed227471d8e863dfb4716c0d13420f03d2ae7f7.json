  "query": "SELECT p.id, r.path AS \"path!\" FROM projects p\n             JOIN namespaces n ON n.id = p.namespace_id AND n.kind = 'user' AND n.owner_id = $1\n             JOIN routes r ON r.source_type = 'project' AND r.source_id = p.id\n            ORDER BY 2",
