{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CodeQL",
          "semanticVersion": "2.19.0",
          "rules": [
            {
              "id": "js/sql-injection",
              "name": "js/sql-injection",
              "shortDescription": { "text": "Database query built from user-controlled sources" },
              "fullDescription": { "text": "Building a database query from user-controlled sources is vulnerable to insertion of malicious code by the user." },
              "help": { "text": "Use parameterized queries." },
              "defaultConfiguration": { "level": "error" },
              "properties": { "tags": ["security", "external/cwe/cwe-089", "external/cwe/cwe-090"], "security-severity": "8.8" }
            },
            {
              "id": "js/unused-local-variable",
              "shortDescription": { "text": "Unused variable" },
              "defaultConfiguration": { "level": "note" },
              "properties": { "tags": ["maintainability"] }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "js/sql-injection",
          "ruleIndex": 0,
          "message": { "text": "This query depends on a [user-provided value](1)." },
          "locations": [{ "physicalLocation": { "artifactLocation": { "uri": "src/routes/users.js", "uriBaseId": "%SRCROOT%" }, "region": { "startLine": 21, "startColumn": 5, "endLine": 22 } } }],
          "partialFingerprints": { "primaryLocationLineHash": "6c1f3e2b2a9d0f11:1" }
        },
        {
          "ruleId": "js/unused-local-variable",
          "level": "note",
          "message": { "text": "Unused variable tmp." },
          "locations": [{ "physicalLocation": { "artifactLocation": { "uri": "file:///src/app.js" }, "region": { "startLine": 3 } } }]
        }
      ]
    }
  ]
}
