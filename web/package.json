{
  "name": "forgust-web",
  "description": "The web app the server serves",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "licenses": "node scripts/licenses.mjs",
    "gen:api": "npm ci --prefix tools/gen-api --no-audit --no-fund --silent && tools/gen-api/node_modules/.bin/openapi-typescript openapi.json -o src/api/schema.d.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/merge": "6.13.0",
    "@codemirror/search": "6.7.3",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.44.2",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "@replit/codemirror-vim": "6.4.0",
    "@tanstack/react-query": "5.108.4",
    "@tanstack/react-virtual": "3.14.28",
    "@xyflow/react": "13.0.3",
    "elkjs": "0.12.1",
    "katex": "^0.19.1",
    "lucide-react": "1.78.0",
    "mermaid": "12.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.6"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "7.0.2",
    "vite": "^8.3.8"
  }
}
